{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "required": [
    "canvas",
    "format_version"
  ],
  "properties": {
    "animations": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Animation"
      }
    },
    "canvas": {
      "$ref": "#/definitions/Canvas"
    },
    "expressions": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Expression"
      }
    },
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "glues": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/GlueBinding"
      }
    },
    "keyforms": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/KeyformBinding"
      }
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "parameter_groups": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/ParameterGroup"
      }
    },
    "parameters": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Parameter"
      }
    },
    "physics": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PhysicsGroup"
      }
    },
    "pose_groups": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PoseGroup"
      }
    },
    "textures": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TextureMeta"
      }
    }
  },
  "definitions": {
    "Animation": {
      "type": "object",
      "required": [
        "duration_frames",
        "id",
        "name",
        "tracks"
      ],
      "properties": {
        "duration_frames": {
          "type": "number",
          "format": "float"
        },
        "fps": {
          "default": 30.0,
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "loop_playback": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimationTrack"
          }
        }
      }
    },
    "AnimationTrack": {
      "type": "object",
      "required": [
        "keyframes",
        "target_param_id"
      ],
      "properties": {
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineKeyframe"
          }
        },
        "target_param_id": {
          "type": "string"
        }
      }
    },
    "BlendMode": {
      "type": "string",
      "enum": [
        "normal",
        "multiply",
        "screen",
        "additive"
      ]
    },
    "Canvas": {
      "type": "object",
      "required": [
        "height",
        "width"
      ],
      "properties": {
        "background_color": {
          "default": "#18181b",
          "type": "string"
        },
        "height": {
          "type": "number",
          "format": "float"
        },
        "origin_x": {
          "default": 0.0,
          "type": "number",
          "format": "float"
        },
        "origin_y": {
          "default": 0.0,
          "type": "number",
          "format": "float"
        },
        "width": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "CurveType": {
      "type": "string",
      "enum": [
        "linear",
        "stepped",
        "bezier"
      ]
    },
    "Expression": {
      "type": "object",
      "required": [
        "id",
        "name",
        "parameters"
      ],
      "properties": {
        "fade_in_time": {
          "default": 0.5,
          "type": "number",
          "format": "float"
        },
        "fade_out_time": {
          "default": 0.5,
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExpressionParameter"
          }
        }
      }
    },
    "ExpressionBlendType": {
      "type": "string",
      "enum": [
        "add",
        "multiply",
        "overwrite"
      ]
    },
    "ExpressionParameter": {
      "type": "object",
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "blend": {
          "default": "add",
          "allOf": [
            {
              "$ref": "#/definitions/ExpressionBlendType"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "ExtendedInterpolationType": {
      "type": "string",
      "enum": [
        "linear",
        "circle",
        "bezier"
      ]
    },
    "GlueBinding": {
      "type": "object",
      "required": [
        "id",
        "mesh_a_id",
        "mesh_b_id",
        "name",
        "vertex_pairs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mesh_a_id": {
          "type": "string"
        },
        "mesh_b_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vertex_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GluePair"
          }
        }
      }
    },
    "GluePair": {
      "type": "object",
      "required": [
        "index_a",
        "index_b",
        "weight_a",
        "weight_b"
      ],
      "properties": {
        "index_a": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "index_b": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "weight_a": {
          "type": "number",
          "format": "float"
        },
        "weight_b": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "KeyformBinding": {
      "type": "object",
      "required": [
        "dimensions",
        "keyforms",
        "target_node_id"
      ],
      "properties": {
        "dimensions": {
          "description": "One or more parameters driving this node (e.g. ParamAngleX, ParamAngleY)",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParamDimension"
          }
        },
        "keyforms": {
          "description": "Keyform entries for each combination of key values across dimensions",
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeyformState"
          }
        },
        "target_node_id": {
          "type": "string"
        }
      }
    },
    "KeyformPayload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "control_points",
            "kind"
          ],
          "properties": {
            "control_points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "Warp"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "angle_deg",
            "kind",
            "origin",
            "scale"
          ],
          "properties": {
            "angle_deg": {
              "type": "number",
              "format": "float"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Rotation"
              ]
            },
            "origin": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "control_points",
            "kind"
          ],
          "properties": {
            "control_points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "DeformPath"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "vertex_offsets"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ArtMesh"
              ]
            },
            "multiply_color": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "opacity": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "screen_color": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "vertex_offsets": {
              "description": "Vertex positions or offsets",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "KeyformState": {
      "type": "object",
      "required": [
        "coordinates",
        "payload"
      ],
      "properties": {
        "coordinates": {
          "description": "Key values per dimension corresponding to this state, e.g. [-30.0, 0.0]",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "payload": {
          "$ref": "#/definitions/KeyformPayload"
        }
      }
    },
    "MorphTarget": {
      "type": "object",
      "required": [
        "id",
        "name",
        "param_id",
        "vertex_offsets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "param_id": {
          "type": "string"
        },
        "vertex_offsets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "maxItems": 2,
            "minItems": 2
          }
        }
      }
    },
    "Node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/NodeKind"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "NodeKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "collapsed": {
              "default": false,
              "type": "boolean"
            },
            "opacity": {
              "default": 1.0,
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "enum": [
                "Part"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bounds",
            "cols",
            "control_points",
            "rows",
            "type"
          ],
          "properties": {
            "bezier_smooth": {
              "default": false,
              "type": "boolean"
            },
            "bounds": {
              "description": "[min_x, min_y, width, height]",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "cols": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "control_points": {
              "description": "(cols + 1) * (rows + 1) control points in canvas space",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "rows": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "WarpDeformer"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "origin",
            "type"
          ],
          "properties": {
            "angle_deg": {
              "default": 0.0,
              "type": "number",
              "format": "float"
            },
            "origin": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "scale": {
              "default": [
                1.0,
                1.0
              ],
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "type": {
              "type": "string",
              "enum": [
                "RotationDeformer"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "control_points",
            "type"
          ],
          "properties": {
            "control_points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "target_mesh_ids": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "DeformPath"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "indices",
            "texture_id",
            "type",
            "uvs",
            "vertices"
          ],
          "properties": {
            "blend_mode": {
              "default": "normal",
              "allOf": [
                {
                  "$ref": "#/definitions/BlendMode"
                }
              ]
            },
            "draw_order": {
              "default": 0,
              "type": "integer",
              "format": "int32"
            },
            "hit_area_name": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            },
            "is_mask_inverted": {
              "default": false,
              "type": "boolean"
            },
            "mask_ids": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "morph_targets": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/MorphTarget"
              }
            },
            "multiply_color": {
              "default": [
                1.0,
                1.0,
                1.0,
                1.0
              ],
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "opacity": {
              "default": 1.0,
              "type": "number",
              "format": "float"
            },
            "screen_color": {
              "default": [
                0.0,
                0.0,
                0.0,
                0.0
              ],
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "texture_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "ArtMesh"
              ]
            },
            "user_data": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "uvs": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "vertices": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "ParamDimension": {
      "type": "object",
      "required": [
        "keys",
        "param_id"
      ],
      "properties": {
        "extended_interpolation": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ExtendedInterpolationType"
            },
            {
              "type": "null"
            }
          ]
        },
        "keys": {
          "description": "Monotonically increasing key values, e.g. [-30.0, 0.0, 30.0]",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "param_id": {
          "type": "string"
        }
      }
    },
    "Parameter": {
      "type": "object",
      "required": [
        "default",
        "id",
        "max",
        "min",
        "name"
      ],
      "properties": {
        "default": {
          "type": "number",
          "format": "float"
        },
        "group_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "max": {
          "type": "number",
          "format": "float"
        },
        "min": {
          "type": "number",
          "format": "float"
        },
        "name": {
          "type": "string"
        },
        "repeats": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "ParameterGroup": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "collapsed": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "PhysicsGroup": {
      "type": "object",
      "required": [
        "id",
        "inputs",
        "name",
        "outputs",
        "pendulums"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PhysicsInput"
          }
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PhysicsOutput"
          }
        },
        "pendulums": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PhysicsPendulum"
          }
        }
      }
    },
    "PhysicsInput": {
      "type": "object",
      "required": [
        "param_id",
        "weight"
      ],
      "properties": {
        "param_id": {
          "type": "string"
        },
        "reflect": {
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "PhysicsOutput": {
      "type": "object",
      "required": [
        "angle_scale",
        "param_id",
        "pendulum_index",
        "weight"
      ],
      "properties": {
        "angle_scale": {
          "type": "number",
          "format": "float"
        },
        "param_id": {
          "type": "string"
        },
        "pendulum_index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "weight": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "PhysicsPendulum": {
      "type": "object",
      "required": [
        "damping",
        "length",
        "mass"
      ],
      "properties": {
        "damping": {
          "type": "number",
          "format": "float"
        },
        "length": {
          "type": "number",
          "format": "float"
        },
        "mass": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "PoseGroup": {
      "type": "object",
      "required": [
        "id",
        "name",
        "part_ids"
      ],
      "properties": {
        "fade_in_time": {
          "default": 0.5,
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "part_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TextureMeta": {
      "type": "object",
      "required": [
        "height",
        "id",
        "path",
        "width"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "TimelineKeyframe": {
      "type": "object",
      "required": [
        "frame",
        "value"
      ],
      "properties": {
        "bezier_handles": {
          "description": "Tangents for cubic bezier: [cx1, cy1, cx2, cy2]",
          "default": null,
          "type": [
            "array",
            "null"
          ],
