{
  "name": "@l2d/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "l2d-mcp": "./dist/bin.js"
  },
  "exports": {
