{
  "name": "l2d-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first desktop editor for 2D puppet rigging",
  "author": "L2DEditor contributors",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsyzxjn/L2DEditor.git",
    "directory": "apps/desktop"
  },
  "main": "./dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && tsc && vite build",
    "lint": "tsc --noEmit",
    "package:desktop": "electron-builder --publish never",
    "package:desktop:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "@l2d/command": "workspace:*",
    "@l2d/mcp-server": "workspace:*",
    "@l2d/psd": "workspace:*",
    "@l2d/renderer": "workspace:*",
    "@l2d/schema": "workspace:*",
    "@napi-rs/canvas": "^1.0.11",
    "cmdk": "^1.1.1",
    "dockview-react": "^8.5.1",
    "earcut": "^3.2.4",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.16.0",
    "pixi.js": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0"
  }
}
